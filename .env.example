# Copy to .env.local for local development. Production and staging set
# these in Vercel (Settings > Environment Variables) - see DEPLOYMENT.md.
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them.

# Unset in production; "staging" on the staging branch.
NEXT_PUBLIC_APP_ENV=

# Backend API, including /api. The socket connects to the same host.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Cloudinary unsigned uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
